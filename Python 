import hashlib
import json
import time
from typing import Dict, List, Tuple

class AdvancedSullivanCountyAuditorCircuit:
    """
    Enhanced Sullivan County Auditor Circuit (County #77) featuring
    Council Appropriation Pre-Checks and Zero-Advance Enforcement.
    """
    def __init__(self):
        self.county_number = 77
        self.jurisdiction = "Sullivan County, Indiana"
        self.physical_enclave = "Courthouse Room 202, 27 S. Main St., Sullivan, IN"
        
        self.sboa_uniform_compliance = {
            "use_prescribed_forms_only": True,        # IC 5-11-1-21
            "require_gateway_annual_report": True,   # State Gateway Sync
            "coso_internal_controls_passed": True,   # IC 5-11-1-27
            "zero_advance_disbursements": True      # Public funds ledger rule
        }
        
        self.municipal_fund_ledgers: Dict[str, float] = {}
        self.council_appropriations: Dict[str, float] = {}
        self.gateway_state_history: List[Dict] = []

    def allocate_municipal_grant_fund(self, fund_id: str, balance_credits: float, authorized_appropriation: float):
        """Initializes fund and sets explicit Sullivan County Council appropriation limits."""
        self.municipal_fund_ledgers[fund_id] = balance_credits
        self.council_appropriations[fund_id] = authorized_appropriation
        print(f"[FUND INITIALIZED] Slot '{fund_id}' | Balance: {balance_credits:,.2f} CR | Council Approp: {authorized_appropriation:,.2f} CR")

    def process_county_claim(self, fund_id: str, claim_amount: float, claim_metadata: Dict) -> Tuple[bool, str]:
        """
        Audits an incoming expense warrant against SBOA compliance predicates,
        council appropriation caps, and zero-advance rules.
        """
        print(f"\n[AUDITING CLAIM] Processing warrant for '{fund_id}'... Amt: {claim_amount:,.2f} CR")
        
        # 1. Prescribed Form Check (IC 5-11-1-21)
        if not claim_metadata.get("has_sboa_prescribed_form_validation", False):
            return False, "REJECTED_BY_SBOA_FORM_INFRACTION (IC 5-11-1-21 Violation)"
            
        # 2. Internal Controls Check (IC 5-11-1-27)
        if not self.sboa_uniform_compliance["coso_internal_controls_passed"]:
            return False, "REJECTED_INTERNAL_CONTROL_FAILURE (IC 5-11-1-27 Fault)"

        # 3. Zero-Advance Disbursement Rule (Public Funds Ledger)
        if self.sboa_uniform_compliance["zero_advance_disbursements"] and claim_metadata.get("is_advance_payment", False):
            return False, "REJECTED_ZERO_ADVANCE_VIOLATION (Goods/services must be received prior to disbursement)"

        # 4. Council Appropriation Cap Check
        authorized_cap = self.council_appropriations.get(fund_id, 0.0)
        if claim_amount > authorized_cap:
            return False, f"REJECTED_EXCEEDS_COUNCIL_APPROPRIATION (Cap: {authorized_cap:,.2f} CR)"

        # 5. Liquidity Constraint Check
        current_fund_balance = self.municipal_fund_ledgers.get(fund_id, 0.0)
        if claim_amount > current_fund_balance:
            return False, "REJECTED_UNFUNDED_APPROPRIATION_BYPASS"

        # State Transition
        self.municipal_fund_ledgers[fund_id] -= claim_amount
        self.council_appropriations[fund_id] -= claim_amount
        timestamp = time.time()
        
        sync_payload = {
            "county": self.county_number,
            "timestamp": timestamp,
            "fund_id": fund_id,
            "amount_disbursed": claim_amount,
            "state_signature": hashlib.sha256(f"{fund_id}-{claim_amount}-{timestamp}".encode()).hexdigest()
        }
        self.gateway_state_history.append(sync_payload)
        
        return True, f"APPROVED_AND_CERTIFIED_BY_AUDITOR_77 | Block Hash: {sync_payload['state_signature'][:16]}..."
